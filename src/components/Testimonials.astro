---
import { ph } from '../lib/site.js';
interface Props { items: { quote: string; name: string; designation: string; company: string }[] }
const { items } = Astro.props;
---
<div class="tst" data-carousel>
  <ul class="tst__track" tabindex="0" aria-label="Client testimonials">
    {items.map((t) => (
      <li class="tst__item">
        <blockquote>
          <svg class="tst__q" viewBox="0 0 32 24" aria-hidden="true"><path d="M0 24V14C0 6 4 1 12 0l1 4c-4 1-6 4-6 8h5v12H0zm19 0V14c0-8 4-13 12-14l1 4c-4 1-6 4-6 8h5v12H19z" fill="currentColor"/></svg>
          <p set:html={ph(t.quote)} />
          <footer><strong set:html={ph(t.name)} /><span set:html={`${ph(t.designation)}, ${ph(t.company)}`} /></footer>
        </blockquote>
      </li>
    ))}
  </ul>
  <div class="tst__nav">
    <button type="button" class="tst__btn" data-dir="-1" aria-label="Previous testimonial"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
    <button type="button" class="tst__btn" data-dir="1" aria-label="Next testimonial"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
  </div>
</div>
<style>
  .tst__track { list-style: none; margin: 0; padding: 4px; display: grid; grid-auto-flow: column; grid-auto-columns: min(100%, 520px); gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .tst__track::-webkit-scrollbar { display: none; }
  .tst__item { scroll-snap-align: start; }
  blockquote { margin: 0; height: 100%; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; display: flex; flex-direction: column; }
  .tst__q { width: 32px; color: var(--magenta); margin-bottom: 14px; }
  blockquote p { font-size: 1.05rem; flex: 1; }
  blockquote footer { display: flex; flex-direction: column; font-size: 0.9rem; color: var(--muted); }
  blockquote strong { color: var(--navy); }
  .tst__nav { display: flex; gap: 10px; margin-top: 20px; }
  .tst__btn { width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--navy); background: #fff; color: var(--navy); display: grid; place-items: center; cursor: pointer; }
  .tst__btn:hover { background: var(--navy); color: #fff; }
  .tst__btn svg { width: 22px; height: 22px; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((c) => {
    const track = c.querySelector<HTMLElement>('.tst__track')!;
    c.querySelectorAll<HTMLButtonElement>('.tst__btn').forEach((b) => b.addEventListener('click', () => {
      const item = track.querySelector<HTMLElement>('.tst__item');
      track.scrollBy({ left: (+b.dataset.dir!) * ((item?.offsetWidth ?? 300) + 20), behavior: 'smooth' });
    }));
  });
</script>
