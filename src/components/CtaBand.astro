---
import Icon from './Icon.astro';
import Dots from './Dots.astro';
import { content, waLink } from '../lib/site.js';
interface Props { headline?: string; text?: string }
const { headline = content.home.cta.headline, text = content.home.cta.text } = Astro.props;
---
<section class="cta section--navy">
  <div class="container cta__in reveal">
    <div>
      <Dots />
      <h2>{headline}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="btn-row">
      <a href="/contact/" class="btn btn--primary">Get a Quote in 24 Hours <Icon name="arrow-right" /></a>
      <a href={waLink()} class="btn btn--whatsapp" target="_blank" rel="noopener" data-track="whatsapp_click"><Icon name="whatsapp" /> WhatsApp Us</a>
    </div>
  </div>
</section>
<style>
  .cta { padding: clamp(48px, 7vw, 80px) 0; position: relative; overflow: hidden; }
  .cta::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: linear-gradient(var(--cyan) 0 25%, var(--magenta) 25% 50%, var(--yellow) 50% 75%, #fff 75%); }
  .cta__in { display: grid; gap: 28px; align-items: center; }
  @media (min-width: 900px) { .cta__in { grid-template-columns: 1.4fr 1fr; } .cta .btn-row { justify-content: flex-end; } }
  .cta h2 { margin: 14px 0 10px; }
  .cta .lead { margin: 0; }
</style>
