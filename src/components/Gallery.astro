---
// Filterable photo gallery with lightbox. Items come from src/data/content/ → work.items.
import { ph } from '../lib/site.js';
interface Item { category: string; caption: string; image: { src: string; alt: string } }
interface Props { items: Item[]; categories?: { id: string; name: string }[]; filters?: boolean }
const { items, categories = [], filters = true } = Astro.props;
---
<div class="gallery" data-gallery>
  {filters && categories.length > 0 && (
    <div class="gallery__tabs" role="group" aria-label="Filter work by category">
      <button type="button" class="gtab" aria-pressed="true" data-filter="all">All</button>
      {categories.map((c) => <button type="button" class="gtab" aria-pressed="false" data-filter={c.id}>{c.name}</button>)}
    </div>
  )}
  <ul class="gallery__grid">
    {items.map((it) => (
      <li class="gitem" data-cat={it.category}>
        <button type="button" class="gitem__btn" data-src={it.image.src} data-alt={it.image.alt} data-caption={it.caption}>
          <span class="gitem__img"><img src={it.image.src} alt={it.image.alt} loading="lazy" decoding="async" width="1200" height="900" /></span>
          <span class="gitem__cap" set:html={ph(it.caption)} />
        </button>
      </li>
    ))}
  </ul>
  <dialog class="lightbox" aria-label="Photo viewer">
    <button type="button" class="lightbox__close" aria-label="Close">×</button>
    <button type="button" class="lightbox__nav lightbox__prev" aria-label="Previous photo">‹</button>
    <figure><img alt="" /><figcaption></figcaption></figure>
    <button type="button" class="lightbox__nav lightbox__next" aria-label="Next photo">›</button>
  </dialog>
</div>
<style>
  .gallery__tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .gtab { font: inherit; font-size: 0.92rem; font-weight: 500; padding: 9px 18px; border-radius: 999px; border: 1px solid var(--line); background: #fff; color: var(--navy); cursor: pointer; min-height: 42px; }
  .gtab:hover { border-color: var(--navy); }
  .gtab[aria-pressed="true"] { background: var(--navy); border-color: var(--navy); color: #fff; }
  .gallery__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  .gitem[hidden] { display: none; }
  .gitem__btn { all: unset; box-sizing: border-box; cursor: zoom-in; display: block; width: 100%; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: transform 0.25s, box-shadow 0.25s; }
  .gitem__btn:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .gitem__btn:focus-visible { outline: 3px solid var(--cyan); outline-offset: 3px; }
  .gitem__img { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #e3e1db; }
  .gitem__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .gitem__btn:hover img { transform: scale(1.04); }
  .gitem__cap { display: block; padding: 12px 16px 14px; font-size: 0.88rem; color: var(--graphite); line-height: 1.5; }
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100%; height: 100%; }
  .lightbox::backdrop { background: rgba(10, 16, 32, 0.92); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox figure { margin: 0; max-width: min(1100px, 92vw); }
  .lightbox img { max-height: 78vh; width: auto; margin: 0 auto; border-radius: var(--radius); }
  .lightbox figcaption { color: #fff; text-align: center; margin-top: 14px; font-size: 0.95rem; }
  .lightbox__close, .lightbox__nav { position: fixed; background: rgba(255,255,255,0.12); color: #fff; border: 0; border-radius: 50%; width: 48px; height: 48px; font-size: 1.8rem; line-height: 1; cursor: pointer; }
  .lightbox__close { top: 16px; right: 16px; }
  .lightbox__nav { top: 50%; transform: translateY(-50%); }
  .lightbox__prev { left: 12px; }
  .lightbox__next { right: 12px; }
  .lightbox button:hover { background: var(--magenta); }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const tabs = g.querySelectorAll<HTMLButtonElement>('.gtab');
    const items = [...g.querySelectorAll<HTMLElement>('.gitem')];
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
      const f = t.dataset.filter;
      items.forEach((it) => (it.hidden = f !== 'all' && it.dataset.cat !== f));
    }));
    const dlg = g.querySelector<HTMLDialogElement>('.lightbox')!;
    const img = dlg.querySelector('img')!, cap = dlg.querySelector('figcaption')!;
    let idx = 0;
    const visible = () => items.filter((i) => !i.hidden).map((i) => i.querySelector<HTMLButtonElement>('.gitem__btn')!);
    const show = (btn: HTMLButtonElement) => {
      img.src = btn.dataset.src!; img.alt = btn.dataset.alt!; cap.textContent = btn.dataset.caption!;
      idx = visible().indexOf(btn);
    };
    const step = (d: number) => { const v = visible(); show(v[(idx + d + v.length) % v.length]); };
    items.forEach((it) => {
      const b = it.querySelector<HTMLButtonElement>('.gitem__btn')!;
      b.addEventListener('click', () => { show(b); dlg.showModal(); });
    });
    dlg.querySelector('.lightbox__close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lightbox__prev')!.addEventListener('click', () => step(-1));
    dlg.querySelector('.lightbox__next')!.addEventListener('click', () => step(1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') step(1); if (e.key === 'ArrowLeft') step(-1); });
  });
</script>
